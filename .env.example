# Claude Custom Gateway settings.
#
# Copy this file to `.env` in the project root and fill in your values:
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# API key clients must send on /api/* and /v1/* as `Authorization
CLAUDE_SERVICE_API_KEY=swaraj

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Bind address: 0.0.0.0 = reachable from your network, 127.0.0.1 = this machine only
CLAUDE_SERVICE_HOST=0.0.0.0

CLAUDE_SERVICE_PORT=6069

CLAUDE_SERVICE_CORS_ORIGINS=*
# uvicorn log level: critical, error, warning, info, debug, trace
CLAUDE_SERVICE_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Claude CLI
# ---------------------------------------------------------------------------

# Full path to the claude executable. Leave empty to auto-detect (PATH, then ~/.local/bin and the npm global folder).
CLAUDE_SERVICE_CLAUDE_BIN=

# Per-request timeout in seconds
CLAUDE_SERVICE_TIMEOUT=600

# ---------------------------------------------------------------------------
# Models and prompts
# ---------------------------------------------------------------------------
CLAUDE_SERVICE_MODELS=sonnet,opus,haiku
# Model used for /v1/chat/completions requests that contain images and omit `model`
CLAUDE_SERVICE_VISION_MODEL=sonnet
# System prompt for /v1 requests that send none (avoids the CLI's ~3k-token agent prompt)
CLAUDE_SERVICE_DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
# Longer client system prompts are cut to this many characters
CLAUDE_SERVICE_SYSTEM_PROMPT_MAX=100000
# Optional --effort level for /v1/chat/completions: low, medium, high, xhigh, max (empty = CLI default)
CLAUDE_SERVICE_EFFORT=
# Prompt-cache TTL for conversation history: 1h, 5m, or off. Must match the CLI's own cache TTL: 1h for Claude subscription logins.
CLAUDE_SERVICE_PROMPT_CACHE_TTL=1h

# ---------------------------------------------------------------------------
# Debug logging
# ---------------------------------------------------------------------------

# Log every request/response body: 1 = on, 0 = off. `claude-debug` forces this on and `claude-pro` forces it off.
CLAUDE_SERVICE_LOG_PAYLOADS=0
# Truncate each logged payload to this many characters (0 = no limit)
CLAUDE_SERVICE_LOG_PAYLOAD_MAX=0
