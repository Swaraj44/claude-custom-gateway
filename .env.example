# Reference only — the service reads process environment variables; it does not load this file automatically.
# Export these in your shell or copy them into your environment before starting the service.
# Values shown are the built-in defaults unless commented out.

CLAUDE_SERVICE_HOST=0.0.0.0
CLAUDE_SERVICE_PORT=6069
CLAUDE_SERVICE_TIMEOUT=600
CLAUDE_SERVICE_API_KEY=swaraj
CLAUDE_SERVICE_VISION_MODEL=sonnet
CLAUDE_SERVICE_PROMPT_CACHE_TTL=1h
# CLAUDE_SERVICE_EFFORT=low
# Comma-separated model IDs for /v1/models (default: read from the Claude CLI model catalog cache).
# CLAUDE_SERVICE_MODELS=sonnet,opus,haiku
# Log every request/response body (1 to enable).
# CLAUDE_SERVICE_LOG_PAYLOADS=0
# Truncate each logged payload to N characters (0 = no limit).
# CLAUDE_SERVICE_LOG_PAYLOAD_MAX=0
# Path to the claude CLI. Auto-detected from PATH, ~/.local/bin, ~/.claude/local,
# and the Claude Code VS Code extension's bundled binary when unset.
# CLAUDE_SERVICE_CLAUDE_BIN=/home/you/.local/bin/claude